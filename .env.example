# 可选。不填也能本地跑（用 PGLite）。
# DATABASE_URL=postgres://user:pass@host/db

# LINUX DO（connect.linux.do）
# 回调必须登记为：https://你的域名/api/linuxdo/callback
LINUX_DO_CLIENT_ID=
LINUX_DO_CLIENT_SECRET=

# 能清空公开榜、跑 IQ 补丁的管理员（逗号分隔：LINUX DO 用户名 / 邮箱 / user id）
# 不填则没有管理员。不要把名单写进源码。
IQBENCH_ADMINS=

# 测评用的 API Key 不要写在这里。打开页面后在输入框里填。
